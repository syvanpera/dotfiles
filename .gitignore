.config/herdr/*.log
.config/herdr/session.json
.config/herdr/*.sock

# Never track SSH key material; config is the only file allowed through
.ssh/*
!.ssh/config

# herdr installs plugins into its config dir: upstream git checkouts plus the
# registry it regenerates from them. Downloaded artifacts, not configuration.
.config/herdr/plugins/
.config/herdr/plugins.json
.config/herdr/.plugins.lock

# omarchy plugin installed as its own git checkout; see README
.config/omarchy/plugins/crmne.hyprmoncfg/

# Backups written in place by config editors
*.bak.*
