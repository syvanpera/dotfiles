{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "tuomo.logo"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray",
          "pinned": [],
          "hidden": []
        },
        {
          "id": "chyld.easy-capture"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "crmne.hyprmoncfg"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 600,
    "screensaver": 900
  },
  "plugins": [
    {
      "id": "tuomo.clipboard"
    },
    {
      "id": "tuomo.emojis"
    },
    {
      "id": "tuomo.image-picker"
    },
    {
      "id": "tuomo.herdr"
    },
    {
      "id": "tuomo.tmux"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.clipboard",
    "omarchy.emojis",
    "omarchy.image-picker"
  ],
  "cloneSourceRestores": [
    "tuomo.clipboard",
    "tuomo.emojis",
    "tuomo.image-picker"
  ]
}
